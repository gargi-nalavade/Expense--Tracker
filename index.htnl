<!DOCTYPE html>
<html>

<head>
    <title>Expense Tracker</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>


<nav class="navbar">

    <h2>💰 Expense Tracker</h2>

    <div>
        <a href="/">Home</a>
        <a href="/add">Add Expense</a>
        <a href="/view">View Expenses</a>
    </div>

</nav>



<div class="container">


    <div class="card welcome">

        <h1>Welcome to Expense Tracker</h1>

        <p>
            Track your daily expenses easily and manage your spending smartly.
        </p>

       


        <br>


        <a href="/add">
            <button>
                ➕ Add Expense
            </button>
        </a>


        <a href="/view">
            <button>
                📋 View Expenses
            </button>
        </a>


    </div>



    <div class="dashboard">


        <div class="card">

            <h2>📊 Total Expenses</h2>

            <h1>
                {{ total_expenses }}
            </h1>

        </div>



        <div class="card">

            <h2>💰 Total Amount Spent</h2>

            <h1>
                ₹ {{ total_amount }}
            </h1>

        </div>


    </div>



   
 

</div>


</body>

</html>
Displaying index.html.
